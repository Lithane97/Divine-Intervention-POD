template DI_CE_Lifestyle_Tab
{
    vbox = {
        name = "lifestyle_tab"
        visible = "[And( GetVariableSystem.HasValue('char_editor_tab', 'presents'), GetVariableSystem.HasValue('ce_presents_tab', 'lifestyle'))]"
        layoutpolicy_horizontal = expanding

        margin = { 20 5 }

        using = Animation_Tab_Switch

        vbox = {
            scrollbox = {
                layoutpolicy_horizontal = expanding
                size = { 400 350 }

                blockoverride "scrollbox_content"
                {
                    vbox = {
                        name = "presents_list"
                        layoutpolicy_horizontal = expanding
                        spacing = 5

                        # All Lifestyle Button
                        hbox = {
                            layoutpolicy_horizontal = expanding

                            button_standard = {
                                layoutpolicy_horizontal = expanding
                                size = { 0 50 }
                                button_ignore = none

                                onclick = "[GetScriptedGui('DI_ce_add_all_lifestyle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                                onrightclick = "[GetScriptedGui('DI_ce_remove_all_lifestyle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

                                hbox = {
                                    margin = { 5 0 }
                                    margin_right = 10
                                    spacing = 10

                                    icon = {
                                        size = { 35 35 }
                                        framesize = { 160 160 }
                                        frame = "1"
                                        texture = "gfx/interface/icons/event_types/type_majesty.dds"
                                    }

                                    text_single = {
                                        layoutpolicy_horizontal = expanding

                                        text = DI_ce_all_lifestyle_button

                                        default_format = "#clickable"
                                    }
                                }
                                tooltip = DI_ce_all_lifestyle_button_tt
                            }
                            hbox = {
                                minimumsize = { 76 -1 }
                            }
                        }

                        # All Animal Lifestyle Button
                        hbox = {
                            layoutpolicy_horizontal = expanding

                            DI_lifestyle_present_button = {
                                datacontext = "[GetLifestyle('animal_lifestyle')]"
                                onclick = "[GetScriptedGui('DI_ce_add_animal_lifestyle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                                onrightclick = "[GetScriptedGui('DI_ce_remove_animal_lifestyle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                            }
                            hbox = {
                                minimumsize = { 76 -1 }
                            }
                        }

                        # All Arcana Lifestyle Button
                        hbox = {
                            layoutpolicy_horizontal = expanding

                            DI_lifestyle_present_button = {
                                datacontext = "[GetLifestyle('arcana_lifestyle')]"
