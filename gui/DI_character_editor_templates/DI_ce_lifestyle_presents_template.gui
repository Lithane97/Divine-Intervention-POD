types DILifestylePresentsShared
{
    type DI_lifestyle_present_button = button_standard {
        layoutpolicy_horizontal = expanding
        size = { 0 50 }
        button_ignore = none

        hbox = {
            margin = { 5 0 }
            margin_right = 10
            spacing = 10

            icon = {
                size = { 35 35 }
                framesize = { 160 160 }
                frame = "1"
                texture = "[Lifestyle.GetIcon]"
            }

            text_single = {
                layoutpolicy_horizontal = expanding
                text = "DI_ce_lifestyle_button"
                default_format = "#clickable"
            }
        }

        tooltip = "DI_ce_lifestyle_button_tt"
    }
}
