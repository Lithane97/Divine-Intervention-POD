                    onclick = "[GetScriptedGui('DI_add_innovation_wootz_steel').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                }
            }


            DI_innovation_flowcontainer = {
                datacontext = "[GetCultureInnovationType('innovation_african_canoes')]"

                blockoverride "has_visible" {
                    visible = "[GetScriptedGui('DI_culture_has_innovation_african_canoes').IsValid(GuiScope.SetRoot(Culture.MakeScope).End)]"
                }

                blockoverride "on_remove" {
                    onrightclick = "[GetScriptedGui('DI_remove_innovation_african_canoes').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                }

                blockoverride "not_has_visible" {
                    visible = "[Not(GetScriptedGui('DI_culture_has_innovation_african_canoes').IsValid(GuiScope.SetRoot(Culture.MakeScope).End))]"
                }

                blockoverride "on_add" {
                    onclick = "[GetScriptedGui('DI_add_innovation_african_canoes').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                }
            }
        }
    }
}